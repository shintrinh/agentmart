# Copy to .env and fill in your PayPal sandbox app credentials.
# Create a free sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Public base URL of this server (used for PayPal return/cancel URLs).
# For local demos keep localhost; when deployed, set the real https URL.
BASE_URL=http://localhost:3000
PORT=3000
# LLM chain for the shopping agent (OpenAI-compatible Chat Completions).
# Primary: Fireworks Muse Spark Open. Fallback: env-configured (e.g. Baseten).
# Fallback2: env-configured, intended for a Modal endpoint — set all three
# (key + base URL + model) or the tier stays off. Leave all keys empty to run
# the deterministic fallback engine. Meta muse-spark-1.3 can be swapped in as
# primary via LLM_BASE_URL / LLM_MODEL.
LLM_API_KEY=
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/muse-spark-open
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_FALLBACK_MODEL=accounts/fireworks/models/muse-spark-open
LLM_FALLBACK2_API_KEY=
LLM_FALLBACK2_BASE_URL=
LLM_FALLBACK2_MODEL=
